# Copy to .env (gitignored) and fill in values, OR keep keys in a file outside the repo and
# make .env a single line pointing at it:
#   CACHEREG_SECRETS_FILE=~/path/to/your/secrets.env
# Never commit real values. `cachereg status` shows which are set (never their values).

# OpenRouter datasets API — any OpenRouter API key works.
OPENROUTER_API_KEY=

# Artificial Analysis data API — free key from artificialanalysis.ai.
ARTIFICIAL_ANALYSIS_API_KEY=

# Ramp Data (AI Index, Ramp Rate) — provisioned via the Ramp Data Partner Program.
RAMP_DATA_API_KEY=

# SEC EDGAR asks for a descriptive User-Agent with a contact address.
SEC_EDGAR_USER_AGENT="Your Name you@example.com"

# Optional: Hugging Face token (higher rate limits).
HF_TOKEN=
